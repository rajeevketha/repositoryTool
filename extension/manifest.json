{
  "manifest_version": 3,
  "name": "OrgFlow",
  "version": "1.7.0",
  "description": "Sequential Salesforce metadata deploys (Start → Type → Members → Review → Deploy) with a dark orange workbench and live selected-package inspector.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OrgFlow — Salesforce deployments",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.cloudforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.sfcrmapps.cn/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ]
}
